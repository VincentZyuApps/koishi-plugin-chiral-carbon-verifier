* text eol=lf

*.png -text
*.jpg -text
*.ico -text
*.gif -text
*.webp -text

# 📚 将所有 Markdown 与 README 纳入 GitHub Linguist 语言统计
README.md linguist-language=Markdown linguist-detectable=true linguist-documentation=false
readme.md linguist-language=Markdown linguist-detectable=true linguist-documentation=false
*.md linguist-language=Markdown linguist-detectable=true linguist-documentation=false
docs/**/*.md linguist-language=Markdown linguist-detectable=true linguist-documentation=false

# ⚙️ 将配置文件本身纳入 GitHub Linguist 语言统计
.gitattributes linguist-language=gitattributes linguist-detectable=true linguist-documentation=false -linguist-vendored -linguist-generated
